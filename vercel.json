{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "outputDirectory": "public",
  "functions": {
    "api/ask.mjs": {
      "maxDuration": 300
    },
    "api/search.mjs": {
      "maxDuration": 30
    },
    "api/items.mjs": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/|data/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "cache-control",
          "value": "public, max-age=0, s-maxage=300"
        }
      ]
    }
  ]
}